# Salin menjadi .env (lokal) dan isi juga di Vercel → Settings → Environment Variables.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-dari-supabase
SUPABASE_BUCKET=clinic-uploads

ADMIN_PASSWORD=ganti-dengan-sandi-panjang-acak
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
