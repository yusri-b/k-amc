{
  "name": "klinik-aras-landing",
  "version": "1.1.0",
  "private": true,
  "description": "Landing page + admin panel Klinik Aras Medical Center — HTML, Tailwind CSS, Vercel Functions, and Supabase",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "serve": "node server.mjs",
    "build": "tailwindcss -i src/input.css -o assets/tw.css --minify",
    "dev": "tailwindcss -i src/input.css -o assets/tw.css --watch",
    "seed": "node scripts/seed-supabase.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
